{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "root": true,
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*",
      "!**/node_modules/**/*",
      "!**/build/**/*",
      "!**/coverage/**/*",
      "!**/*.d.ts",
      "!**/generated/*",
      "!**/*.svg"
    ]
  },
  "extends": ["@mkvlrn/config/biome"],
  "overrides": [
    {
      // for tanstack router file based routes
      "includes": ["src/routes/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "off",
            "useExportsLast": "off"
          }
        }
      }
    }
  ]
}
